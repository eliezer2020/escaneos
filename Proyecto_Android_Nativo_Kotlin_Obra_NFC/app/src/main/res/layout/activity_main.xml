<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla del Operador de Obra:
  Ultra minimalista, alto contraste para exteriores a plena luz de sol,
  área de escaneo prominente y barra inferior con los 3 círculos de estado requeridos:
  [sqlsaved] [sdcardsaved] [sqlserversaved]
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <!-- Cabecera de la Obra Civil -->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONTROL OBRA · ASISTENCIA CAMIONES"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:letterSpacing="0.08"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPendingCountBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="Pendientes: 0"
        android:textColor="#F59E0B"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Zona Central Minimalista para Acercar Tarjeta NFC -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNfcZone"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="24dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Icono o representación visual de la antena NFC -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:tint="#F59E0B"
                android:src="@android:drawable/ic_menu_compass"
                android:contentDescription="Antena NFC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="ACERCAR TARJETA NFC"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Lectura automática de camión + GPS"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Información de la última unidad procesada -->
    <TextView
        android:id="@+id/tvLastScannedTruck"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Esperando primer escaneo de la jornada..."
        android:textColor="#F8FAFC"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/cardNfcZone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvStatusMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Coloque la tarjeta del camión al reverso del teléfono"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvLastScannedTruck"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón de Sincronización al Final de la Jornada -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSyncEndOfDay"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:text="SINCRONIZAR JORNADA (MYSQL)"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#F59E0B"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toTopOf="@id/bottomStatusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnManualBackupSd"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Respaldar Base a Micro SD"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@id/btnSyncEndOfDay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================================================================
         BARRA INFERIOR CON LOS 3 CÍRCULOS DE ESTADO REQUERIDOS:
         1. sqlsaved       (Base de datos SQLite interna)
         2. sdcardsaved    (Respaldo en tarjeta Micro SD externa)
         3. sqlserversaved (Servidor central MySQL vía HTTP PUT)
         =================================================================== -->
    <LinearLayout
        android:id="@+id/bottomStatusBar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#020617"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CÍRCULO 1: sqlsaved -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/circleSqlSaved"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#475569" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="sqlsaved"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divisor sutil -->
        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:background="#1E293B" />

        <!-- CÍRCULO 2: sdcardsaved -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/circleSdCardSaved"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#475569" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="sdcardsaved"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divisor sutil -->
        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:background="#1E293B" />

        <!-- CÍRCULO 3: sqlserversaved -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/circleSqlServerSaved"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#475569" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="sqlserversaved"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
